{
  "name": "alicia-jeff-wedding",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "vite build && node scripts/copy-wedding-assets.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "start": "node server/index.mjs",
    "test:server": "node --test server/server.test.mjs",
    "dev:legacy": "node scripts/dev-legacy.mjs",
    "dev:vercel": "node scripts/vercel-dev.mjs --listen 3000",
    "test:api": "node --test tests/*.test.mjs",
    "test:experience": "node scripts/test-experience.mjs",
    "test": "npm run test:server && npm run test:api && npm run test:experience",
    "check:secrets": "node scripts/check-frontend-secrets.mjs",
    "inspect:supabase": "node scripts/inspect-supabase.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "diagnose": "node scripts/diagnose-runtime.mjs",
    "audit:activation": "node --test tests/activation*.test.mjs",
    "backup:business": "node scripts/backup-business-readonly.mjs",
    "prepare:rollback": "node scripts/prepare-activation-rollback.mjs",
    "test:concurrency": "node scripts/test-ticket-concurrency.mjs",
    "inspect:tickets": "node scripts/inspect-ticket-readiness.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "google-auth-library": "^10.9.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.446.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vercel": "^65.15.0",
    "vite": "^7.3.7"
  },
  "overrides": {
    "tar": "^7.5.23"
  },
  "engines": {
    "node": "22.x"
  }
}
