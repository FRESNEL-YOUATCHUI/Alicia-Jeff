# Frontend: valeurs publiques fictives, incorporées au build Vite.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLE
# Serveur uniquement: jamais de préfixe VITE_.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SECRET_KEY=sb_secret_EXEMPLE
# Configurer les quatre variables séparément pour Development / Preview / Production.
# .env.local est ignoré. Ne jamais committer ses valeurs.
# Le backend historique conserve sa propre configuration .env.wedding.local.
# Serveur uniquement : jeton aléatoire >=32 caractères pour le cron de nettoyage.
# Vercel ajoutera automatiquement Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=EXEMPLE_REMPLACER_PAR_UNE_VALEUR_ALEATOIRE_PRIVEE

# Lecture de la liste PRIVEE par OIDC, exclusivement serveur, jamais VITE_.
# Compte de service Lecteur ; aucune publication Web et aucune cle privee Google.
GOOGLE_SHEETS_SPREADSHEET_ID=1mikI1pPvSK0CvslUlUKlwROowJBP5Q9FCzGiZ9ucUB0
GOOGLE_SHEETS_RANGE="'Invités'!A2:A"
# Valeurs verifiees, facultatives car deja definies par defaut cote serveur.
# Une valeur differente provoque un refus securise.
GCP_PROJECT_ID=alicia-jeff-mariage
GCP_PROJECT_NUMBER=691833411750
GCP_WORKLOAD_IDENTITY_POOL_ID=alicia-jeff-vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel-alicia-jeff
GCP_SERVICE_ACCOUNT_EMAIL=alicia-jeff-invites@alicia-jeff-mariage.iam.gserviceaccount.com
# Vercel fournit VERCEL=1, VERCEL_ENV=production et le jeton OIDC de requete.
# Ne pas fabriquer ces valeurs en local ni stocker de jeton dans ce fichier.
# mixed : les deux ordres exacts sont acceptes ; plusieurs lignes bloquent l'entree.
GUEST_NAME_ORDER=mixed

# Adresse publique des QR. Valeur par défaut dans le code : https://alicia-jeff.vercel.app
# Ne jamais mettre localhost ici pour des billets destinés aux téléphones.
VITE_PUBLIC_SITE_URL=https://alicia-jeff.vercel.app

# Diagnostic Google temporaire, serveur uniquement. Activation manuelle en Production.
# Ne pas modifier .env.local automatiquement. Valeurs non secretes.
# Sans activation ET une date UTC future, la route renvoie 404.
GOOGLE_SHEETS_READINESS_ENABLED=false
GOOGLE_SHEETS_READINESS_UNTIL=
