# Frontend: valeurs publiques fictives, incorporées au build Vite.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLE
# Serveur uniquement: jamais de préfixe VITE_.
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SECRET_KEY=sb_secret_EXEMPLE
# Configurer les quatre variables séparément pour Development / Preview / Production.
# .env.local est ignoré. Ne jamais committer ses valeurs.
# Le backend historique conserve sa propre configuration .env.wedding.local.
# Serveur uniquement : jeton aléatoire >=32 caractères pour le cron de nettoyage.
# Vercel ajoutera automatiquement Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=EXEMPLE_REMPLACER_PAR_UNE_VALEUR_ALEATOIRE_PRIVEE

# Lecture de la liste PRIVEE, exclusivement côté serveur, jamais VITE_.
# Ne pas publier la feuille sur le Web. Partager en lecture avec le compte de service uniquement.
# Valeurs à renseigner vous-même après validation ; aucun secret existant n'est modifié.
GOOGLE_SHEETS_SPREADSHEET_ID=1mikI1pPvSK0CvslUlUKlwROowJBP5Q9FCzGiZ9ucUB0
GOOGLE_SHEETS_RANGE="'Invités'!A2:A"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# mixed : les deux ordres exacts sont acceptés ; plusieurs lignes correspondantes bloquent l'entrée.
GUEST_NAME_ORDER=mixed

# Adresse publique des QR. Valeur par défaut dans le code : https://alicia-jeff.vercel.app
# Ne jamais mettre localhost ici pour des billets destinés aux téléphones.
VITE_PUBLIC_SITE_URL=https://alicia-jeff.vercel.app
